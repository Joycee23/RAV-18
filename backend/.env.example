# Supabase Dashboard > Project Settings > Database > connection string (SQLAlchemy/psycopg).
DATABASE_URL=
SUPABASE_URL=
# Supabase public anon key, used to validate signed-in users through Auth.
SUPABASE_ANON_KEY=
# Backend only; Storage operations only. Never expose this key in frontend or logs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=incident-media
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_VIDEO_BYTES=100000000
MAX_VIDEO_DURATION_SECONDS=300
VIDEO_ANALYSIS_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:5173
